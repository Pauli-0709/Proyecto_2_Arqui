# Esta linea va a  habilitar la construccion del soporte de instrucciones.
BUILD_ISA=y

# Esta linea va a seleccionar la arquitectura ARM.
USE_ARM_ISA=y

# Esta linea incluye Ruby.
RUBY=y

# Esta linea es la construccion que utiliza un protocolo seleccionado.
USE_MULTIPLE_PROTOCOLS=n

# Esta linea selecciona la implementacion MOESI con el directorio de gem5.
PROTOCOL="MOESI_CMP_directory"

# Finalmente se habilita la implementacion seleccionada.
RUBY_PROTOCOL_MOESI_CMP_directory=y
